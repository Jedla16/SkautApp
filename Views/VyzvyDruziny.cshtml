            }
            : new[]
            {
                "Šel jsem spát nejpozději v 22:30 a naspal jsem alespoň osm hodin.",
                "Vypil jsem alespoň 2 litry vody.",
                "Ušel jsem alespoň 10 000 kroků.",
                "Alespoň na 15 minut jsem si zacvičil.",
                "Strávil jsem alespoň 15 minut konverzací nebo jinou vztahy utužující aktivitou se svým rodinným blízkým.",
                "Vykonal jsem alespoň jeden dobrý skutek.",
