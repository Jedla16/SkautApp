    // Heatmap data
    var historieSplnenych = ModryZivotService.GetHistoriePocetSplnenych(memberId, 90);
    var today = DateTime.Today;
}

@* TENTO ŘÁDEK JE KLÍČOVÝ PRO ODSTRANĚNÍ CHYBY 400 *@
@Html.AntiForgeryToken()

<style>
    .card-vyzva {
        cursor: pointer;
        transition: 0.2s;
        border-radius: 12px;
        border: 2px solid #dee2e6;
        user-select: none;
    }

    .card-vyzva.splneno {
        background-color: #e8f5e9 !important;
        border-color: #2e7d32 !important;
    }

    .table-vyzvy {
        background: #fff;
        border-radius: 1rem;
        box-shadow: 0 0.5rem 1.25rem rgba(15, 23, 42, 0.06);
        overflow: hidden;
    }

    .table-vyzvy thead th {
        background: #f8fafc;
        border-bottom-width: 1px;
    }

    .table-vyzvy th,
    .table-vyzvy td {
        padding: 1rem 1.25rem;
        vertical-align: middle;
    }

    .table-vyzvy tbody td:first-child {
        padding-left: 1.5rem;
    }

    .table-vyzvy th:first-child,
    .table-vyzvy td:first-child {
        text-align: left;
        width: 78%;
    }

    .table-vyzvy th:last-child,
    .table-vyzvy td:last-child {
        width: 22%;
        text-align: center;
    }

    .table-vyzvy tbody tr.splneno {
        background-color: #eef5ff;
    }

    .table-vyzvy tbody tr:nth-child(even):not(.splneno) {
        background-color: #fbfdff;
    }

    .table-vyzvy tbody tr:hover {
        background-color: #f2f7ff;
    }

    .vyzva-row {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
    }

    .vyzva-dot {
        width: 0.75rem;
        height: 0.75rem;
        margin-top: 0.4rem;
        border-radius: 999px;
        background: linear-gradient(135deg, #004a99, #68a7ff);
        box-shadow: 0 0 0 4px rgba(0, 74, 153, 0.08);
        flex: 0 0 auto;
    }

    .vyzva-text {
        text-align: left;
        line-height: 1.45;
    }

    .btn-vyzva-toggle {
        min-width: 8.5rem;
        border-color: #004a99;
        color: #004a99;
        font-weight: 600;
        transition: background-color 0.2s, color 0.2s, border-color 0.2s;
    }

    .btn-vyzva-toggle:hover,
    .btn-vyzva-toggle:focus {
        background-color: rgba(0, 74, 153, 0.08);
        color: #003366;
        border-color: #003366;
    }

    .btn-vyzva-toggle.is-active {
        background-color: #004a99;
        border-color: #004a99;
        color: #fff;
    }

    .btn-vyzva-toggle.is-active:hover,
    .btn-vyzva-toggle.is-active:focus {
        background-color: #003366;
        border-color: #003366;
        color: #fff;
    }

    .status-text {
        font-weight: bold;
    }

    /* Heatmap styles */
    .heatmap-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(15px, 1fr));
        /* Adjust cell size as needed */
        gap: 2px;
        padding: 10px;
        border-radius: 5px;
        background-color: #e3f2fd;
        /* Light blue */
        margin-top: 20px;
        max-width: 600px;
        /* Limit width for better visual */
        margin-left: auto;
        margin-right: auto;
    }

    .heatmap-cell {
        width: 15px;
        /* Fixed width */
        height: 15px;
        /* Fixed height */
        background-color: #e1f5fe;
        /* Default (no activity) - slightly different light blue */
        border-radius: 2px;
        position: relative;
        cursor: help;
    }

    /* Green shades for activity */
    .level-0 {
        background-color: #e1f5fe;
    }

    .level-1 {
        background-color: #9be9a8;
    }

    /* Light green */
    .level-2 {
        background-color: #40c463;
    }

    /* Medium green */
    .level-3 {
        background-color: #30a14e;
    }

    /* Darker green */
    .level-4 {
        background-color: #216e39;
    }

    /* Darkest green */

    .heatmap-cell::before {
        content: attr(data-date);
        visibility: hidden;
        width: 80px;
        background-color: #333;
        color: #fff;
        text-align: center;
        border-radius: 6px;
        padding: 5px 0;
        position: absolute;
        z-index: 1;
        bottom: 125%;
        /* Position above the cell */
        left: 50%;
        margin-left: -40px;
        opacity: 0;
        transition: opacity 0.3s;
    }

    .heatmap-cell:hover::before {
        visibility: visible;
        opacity: 1;
    }
</style>

<div class="container py-5 text-center">
    <h1 class="display-4 druzina-title">
        <span class="druzina-title__icon">@ikonaDruziny</span>
        <span>@nazevDruziny</span>
    </h1>

    <h2 class="mt-5 mb-3">Tvá historie aktivit</h2>
    <div class="heatmap-container">
        @for (int i = 89; i >= 0; i--) // Loop for the last 90 days
        {
            var date = today.AddDays(-i);
            int count = historieSplnenych.ContainsKey(date) ? historieSplnenych[date] : 0;
            string levelClass = "level-0";
            if (count > 0 && count <= 2) { levelClass = "level-1"; }
            else if (count > 2 && count <= 5) { levelClass = "level-2"; }
            else if (count > 5 && count <= 8) { levelClass = "level-3"; }
            else if (count > 8) { levelClass = "level-4"; }

            <div class="heatmap-cell @levelClass" data-date="@date.ToString("d. M. yyyy") (@count splněno)"></div>
        }
    </div>

    <div class="table-responsive mt-4">
        @{
            var challenges = Model.Children().ToList();
        }
        <table class="table table-vyzvy align-middle">
            <thead>
                <tr>
                    <th scope="col">Výzva</th>
                    <th scope="col" class="text-center">Stav</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < challenges.Count; i++)
                {
                    var vyzva = challenges[i];
                    var dynamicVyzvaText = i < textyVyzvy.Length ? textyVyzvy[i] : null;
                    bool splneno = ModryZivotService.JeSplneno(memberId, vyzva.Id.ToString(), DateTime.Today);
                    <tr class="@(splneno ? "splneno" : "")">
                        <td>
                            <div class="vyzva-row">
                                <span class="vyzva-dot" aria-hidden="true"></span>
                                <div class="fw-medium vyzva-text">@(string.IsNullOrWhiteSpace(dynamicVyzvaText) ? vyzva.Name
                                                                                                                                            : dynamicVyzvaText)</div>
            </div>
        </td>
        <td class="text-center">
            <button type="button"
                    class="btn btn-outline-primary btn-vyzva-toggle rounded-pill @(splneno ? "is-active" : "")"
                    data-vyzva-id="@vyzva.Id" aria-pressed="@(splneno.ToString().ToLowerInvariant())"
                    onclick="ulozitSplneni(event, this)">
                @(splneno ? "Splněno" : "Mám hotovo")
            </button>
        </td>
    </tr>
}
</tbody>
</table>
</div>
</div>

<style>
    .druzina-title {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        justify-content: center;
        margin-bottom: 0;
    }

    .druzina-title__icon {
        font-size: 0.9em;
        line-height: 1;
        filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.12));
    }
</style>

<script>
    async function ulozitSplneni(event, button) {
        const radek = button.closest('tr');
        const budeSplneno = !button.classList.contains('is-active');
        const idVyzvy = button.dataset.vyzvaId;

        // Vizuální změna hned
        button.classList.toggle('is-active', budeSplneno);
        button.setAttribute('aria-pressed', budeSplneno ? 'true' : 'false');
        button.textContent = budeSplneno ? 'Splněno' : 'Mám hotovo';
        radek.classList.toggle('splneno', budeSplneno);

        // ZÍSKÁNÍ TOKENU (Aby nás Umbraco pustilo dál)
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        const formData = new FormData();
        formData.append('vyzvaId', idVyzvy);
        formData.append('splneno', budeSplneno);
        formData.append('__RequestVerificationToken', token); // Přidáme token do dat

        try {
            const response = await fetch('/umbraco/surface/ModryZivot/Zapis', {
                method: 'POST',
                body: formData
            });

            if (!response.ok) throw new Error("Chyba " + response.status);
            console.log("Uloženo!");
        } catch (error) {
            console.error(error);
            alert("Chyba při ukládání. Zkus se znovu přihlásit.");
            button.classList.toggle('is-active', !budeSplneno);
            button.setAttribute('aria-pressed', (!budeSplneno).toString());
            button.textContent = !budeSplneno ? 'Splněno' : 'Mám hotovo';
            radek.classList.toggle('splneno', !budeSplneno);
        }
    }
</script>