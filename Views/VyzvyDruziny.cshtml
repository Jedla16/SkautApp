@using Umbraco.Cms.Web.Common.PublishedModels;
@using SkautApp.Services
@using Umbraco.Cms.Core.Security
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@inject ModryZivotService ModryZivotService
@inject IMemberManager MemberManager

@{
    Layout = "HlavniLayout.cshtml";
    var identityUser = await MemberManager.GetCurrentMemberAsync();
    int memberId = 0;
    if (identityUser != null) { int.TryParse(identityUser.Id, out memberId); }
