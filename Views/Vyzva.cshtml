@using SkautApp.Models;
@using SkautApp.Services;
@using Umbraco.Cms.Core.Security;
@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@inject ModryZivotService ModryZivotService
@inject IMemberManager MemberManager

@{
    Layout = "HlavniLayout.cshtml";

    // Ochrana: Pokud není uživatel přihlášen, přesměrujeme ho na přihlášení
    if (!(Context.User.Identity?.IsAuthenticated ?? false))
    {
        Context.Response.Redirect("/prihlaseni");
        return;
    }

    var member = await MemberManager.GetCurrentMemberAsync();
    int memberId = 0;
    if (member != null)
    {
        int.TryParse(member.Id, out memberId);
    }

    // DYNAMICKÉ NAČTENÍ: Načteme dceřiné uzly (výzvy) aktuální družiny z Umbraca
    var vyzvyDruziny = Model.Children().ToList();

    // Data pro 90denní heatmapu
    var historieSplnenych = ModryZivotService.GetHistoriePocetSplnenych(memberId, 90);
    var today = DateTime.Today;
}

@* Anti-Forgery token pro zabezpečení POST požadavků *@
@Html.AntiForgeryToken()

<div class="container py-5 text-center">
    <div class="mb-5">
        <h1 class="display-5 fw-bold text-primary">@Model.Name ⚜️</h1>
        <p class="lead">Ahoj @(member?.Name ?? "skaute"), zaznamenej si své dnešní úspěchy.</p>
    </div>

    @* Pokud v Umbracu pod touto družinou ještě nejsou vytvořené podstránky výzev *@
    @if (!vyzvyDruziny.Any())
    {
        <div class="alert alert-info p-4 shadow-sm my-4" role="alert">
            <h4 class="alert-heading fw-bold">Zatím tu nejsou žádné výzvy!</h4>
            <p class="mb-0">Pro družinu <strong>@Model.Name</strong> zatím v administraci Umbraca nebyly vytvořeny žádné
                podstránky výzev.</p>
            </div>
        }
    else
        {
            @* Dynamické vykreslení karet z dceřiných uzlů *@
            <div class="row g-4 justify-content-center">
                @foreach (var vyzva in vyzvyDruziny)
                {
                    // Načtení textu z pole 'nazevVyzvy' v Umbracu
                    var nazev = vyzva.Value<string>("nazevVyzvy");

                    // Pokud je pole v administraci prázdné, jako zálohu použijeme systémový název uzlu
                    if (string.IsNullOrWhiteSpace(nazev))
                    {
                        nazev = vyzva.Name;
                    }

                    bool jeSplneno = ModryZivotService.JeSplneno(memberId, vyzva.Id.ToString(), DateTime.Today);

                    <div class="col-md-4 col-sm-6">
                        <div class="card h-100 shadow-sm vyzv-card @(jeSplneno ? "border-success bg-light" : "")"
                             onclick="ulozVyzvu(this, '@vyzva.Id')" style="cursor: pointer; border-width: 2px;">
                            <div class="card-body text-center p-4">
                                <i class="bi bi-star-fill fs-1 mb-3 @(jeSplneno ? "text-success" : "text-primary")"></i>
                                <h5 class="card-title fw-bold">@nazev</h5>
                                <div class="mt-3 status-badge">
                                    @if (jeSplneno)
                                    {
                                        <span class="badge bg-success p-2"><i class="bi bi-check-lg"></i> Splněno</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary p-2">Zbývá</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <script>
        async function ulozVyzvu(element, id) {
            const uzJeSplneno = element.classList.contains('border-success');
            const novyStav = !uzJeSplneno;

            element.classList.toggle('border-success');
            element.classList.toggle('bg-light');

            const badgeDiv = element.querySelector('.status-badge');
            badgeDiv.innerHTML = novyStav
                ? '<span class="badge bg-success p-2"><i class="bi bi-check-lg"></i> Splněno</span>'
                : '<span class="badge bg-secondary p-2">Zbývá</span>';

            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : '';

            const formData = new FormData();
            formData.append('vyzvaId', id);
            formData.append('splneno', novyStav);
            formData.append('__RequestVerificationToken', token);

            try {
                const response = await fetch('/umbraco/surface/ModryZivot/Zapis', {
                    method: 'POST',
                    body: formData
                });

                if (!response.ok) throw new Error("Chyba uložení");
            } catch (error) {
                console.error(error);
                alert("Chyba při ukládání.");
                location.reload();
            }
        }
    </script>

    <style>
        .vyzv-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1) !important;
        }

        .text-primary {
            color: #004a99 !important;
        }
    </style>