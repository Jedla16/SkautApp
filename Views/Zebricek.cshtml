@using SkautApp.Services
@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@inject ModryZivotService ModryZivotService
@inject Umbraco.Cms.Core.Security.IMemberManager MemberManager

@{
    Layout = "HlavniLayout.cshtml"; // Nebo jak se jmenuje tvoje hlavní šablona
    var zebricek = ModryZivotService.GetZebricekJednotlivcu();
    var zebricekDruzin = ModryZivotService.GetZebricekDruzin();
    var aktuálníUživatel = await MemberManager.GetCurrentMemberAsync();
}

<div class="container mt-5">
    <h1 class="text-center mb-4">🏆 Síň slávy Modrého života</h1>

    <div class="row">
        <div class="col-md-8">
            <h3>Jednotlivci</h3>
            <table class="table table-hover border">
                <thead class="table-primary">
                    <tr>
                        <th>#</th>
                        <th>Skaut / Skautka</th>
                        <th>Družina</th>
                        <th class="text-center">Body</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int i = 1; }
                    @foreach (var radek in zebricek)
                    {
                        var jeToJa = (aktuálníUživatel != null && radek.Jmeno == aktuálníUživatel.Name);
                        <tr style="@(jeToJa ? "background-color: #fff3cd; font-weight: bold; border: 2px solid #ffc107;" : "")">
                            <td>@(i++).</td>
                            <td>@radek.Jmeno @(jeToJa ? " (Ty)" : "")</td>
                            <td><span class="badge bg-secondary">@radek.Druzina</span></td>
                            <td class="text-center">@radek.Body</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="col-md-4">
            <h3>Souboj družin</h3>
            <ul class="list-group">
                @foreach (var druzina in zebricekDruzin)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        @druzina.Druzina
                        <span class="badge bg-primary rounded-pill">@druzina.Body b</span>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>