@using Umbraco.Cms.Web.Common.Models
@using SkautApp.Controllers
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<LoginModel>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <div class="text-center mb-1">
            <div class="display-4 mb-0">⚜️</div>
            <h3 class="fw-bold mb-3">Robinsoni Doubravník</h3>
            <p class="text-muted small">Zadej své přihlašovací údaje</p>
        </div>

        @using (Html.BeginUmbracoForm<SkautLoginController>("HandleLogin"))
        {
            @* Token necháváme vypnutý v Controlleru, takže ho zde nepíšeme *@

            <div class="mb-3">
                <label class="form-label fw-semibold">Jméno a příjmení</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-person"></i></span>
                    <input type="text" name="Username" class="form-control bg-light border-start-0"
                           placeholder="jaroslav.foglar" required />
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Heslo</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock"></i></span>
                    <input type="password" id="loginPassword" name="Password" class="form-control bg-light border-start-0"
                           placeholder="••••••••" required />
                    <button type="button" class="btn btn-outline-secondary password-visibility-toggle"
                            id="toggleLoginPassword" aria-label="Zobrazit heslo" aria-pressed="false" hidden>
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold shadow-sm">
                Přihlásit se
            </button>

            @if (TempData["LoginFailure"] != null)
            {
                <div class="alert alert-danger d-flex align-items-center mt-3 mb-0" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <div>@TempData["LoginFailure"]</div>
                </div>
            }
        }
    </div>
</div>

<style>
    /* Malý bonus: Skautská modrá pro tlačítko */
    .btn-primary {
        background-color: #004a99;
        border-color: #004a99;
    }

    .btn-primary:hover {
        background-color: #003366;
        border-color: #003366;
    }

    .form-control:focus {
        border-color: #004a99;
        box-shadow: 0 0 0 0.25rem rgba(0, 74, 153, 0.25);
    }

    .password-visibility-toggle {
        min-width: 2.75rem;
        padding-left: 0.6rem;
        padding-right: 0.6rem;
    }

    .password-visibility-toggle:hover,
    .password-visibility-toggle:focus {
        background-color: #e9ecef;
        border-color: #ced4da;
        color: #212529;
    }
</style>

<script>
    (function () {
        const passwordInput = document.getElementById('loginPassword');
        const toggleButton = document.getElementById('toggleLoginPassword');

        if (!passwordInput || !toggleButton) {
            return;
        }

        const setToggleVisibility = () => {
            toggleButton.hidden = passwordInput.value.length === 0;
        };

        const showPassword = () => {
            if (!passwordInput.value.length) {
                return;
            }

            passwordInput.type = 'text';
            toggleButton.setAttribute('aria-pressed', 'true');
            toggleButton.setAttribute('aria-label', 'Skrýt heslo');
            toggleButton.querySelector('i').className = 'bi bi-eye-slash';
        };

        const hidePassword = () => {
            passwordInput.type = 'password';
            toggleButton.setAttribute('aria-pressed', 'false');
            toggleButton.setAttribute('aria-label', 'Zobrazit heslo');
            toggleButton.querySelector('i').className = 'bi bi-eye';
        };

        passwordInput.addEventListener('input', setToggleVisibility);
        passwordInput.addEventListener('blur', hidePassword);

        toggleButton.addEventListener('pointerdown', function (event) {
            event.preventDefault();
            showPassword();
        });

        toggleButton.addEventListener('pointerup', function () {
            hidePassword();
        });

        toggleButton.addEventListener('pointercancel', function () {
            hidePassword();
        });

        toggleButton.addEventListener('pointerleave', function () {
            hidePassword();
        });

        passwordInput.addEventListener('keyup', setToggleVisibility);
        setToggleVisibility();
    })();
</script>